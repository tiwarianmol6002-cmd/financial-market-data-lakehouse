{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListBucket",
      "Effect": "Allow",
      "Action": ["s3:ListBucket"],
      "Resource": "arn:aws:s3:::anmol-financial-lakehouse-2026",
      "Condition": { "StringLike": { "s3:prefix": ["raw/*"] } }
    },
    {
      "Sid": "WriteRawZone",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:GetObject"],
      "Resource": "arn:aws:s3:::anmol-financial-lakehouse-2026/raw/*"
    }
  ]
}
